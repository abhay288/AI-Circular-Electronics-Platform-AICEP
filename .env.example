# ============================================================
# ECOINTEL PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================

# Database Connection (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ecointel?retryWrites=true&w=majority

# Authentication Secrets (JWT Access & Refresh Tokens)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_characters_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_here

# Asset & Cloud Storage (Cloudinary / S3 Object Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Distributed Cache & Job Queue (Redis + BullMQ)
REDIS_URL=redis://default:<password>@<host>:<port>

# Application Base URL
APP_URL=http://localhost:3000

# AI Component Detection Provider (mock | yolo)
DETECTION_PROVIDER=mock

# External AI Inference Microservice (YOLO / Python FastAPI)
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_API_KEY=eco-intel-internal-ai-key-2026
YOLO_MODEL_PATH=
YOLO_CONFIDENCE=0.35
YOLO_IOU=0.45

# Digital Product Passport Blockchain (Polygon Testnet / Mainnet)
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_PRIVATE_KEY=your_polygon_private_key_do_not_commit
POLYGON_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Decentralized Storage for Passport Metadata (IPFS)
IPFS_API_URL=https://ipfs.infura.io:5001/api/v0

# ============================================================
# PHASE 4: HEALTH ASSESSMENT & REMAINING USEFUL LIFE (RUL)
# ============================================================
RUL_PROVIDER=mock
RUL_MODEL_PATH=ai-service/rul/models/rul_xgb_model.json
RUL_MODEL_VERSION=1.0.0
RUL_DATASET_VERSION=rul-synthetic-v1
RUL_FEATURE_VERSION=rul-features-v1
RUL_CONFIDENCE_THRESHOLD=0.70
RUL_MAX_INPUT_SIZE=500
AI_SERVICE_INTERNAL_KEY=eco-intel-internal-ai-key-2026

# ============================================================
# PHASE 5: MATERIAL RECOVERY INTELLIGENCE & PRECIOUS METALS
# ============================================================
MATERIAL_PROVIDER=mock
MATERIAL_DATABASE_VERSION=mat-comp-v1.0
MATERIAL_MODEL_VERSION=2.0.0
MATERIAL_FEATURE_VERSION=mat-features-v1
MATERIAL_CONFIDENCE_THRESHOLD=0.70
MATERIAL_MAX_INPUT_SIZE=500

# ============================================================
# PHASE 6: REPAIR INTELLIGENCE & CIRCULARITY DECISION ENGINE
# ============================================================
REPAIR_PROVIDER=mock
REPAIR_MODEL_VERSION=1.0.0
REPAIR_FEATURE_VERSION=1.0.0
REPAIR_CONFIDENCE_THRESHOLD=0.75
REPAIR_MAX_INPUT_SIZE=500
REPAIR_SIMULATION_ENABLED=true

# ============================================================
# PHASE 7: DIGITAL PRODUCT PASSPORT (DPP) & BLOCKCHAIN TRACEABILITY
# ============================================================
BLOCKCHAIN_PROVIDER=mock
BLOCKCHAIN_NETWORK=Polygon POS Mainnet
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_CHAIN_ID=137
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CONFIRMATIONS=1
BLOCKCHAIN_ANCHOR_POLICY=manual

PASSPORT_PUBLIC_BASE_URL=http://localhost:3000
PASSPORT_HASH_VERSION=1.0
PASSPORT_VERSION_FORMAT=v{version}
# ============================================================
# PHASE 8: CIRCULAR MARKETPLACE & COMPONENT EXCHANGE
# ============================================================
MARKETPLACE_ENABLED=true
MARKETPLACE_REVIEW_REQUIRED=true
MARKETPLACE_DEFAULT_CURRENCY=INR
MARKETPLACE_PUBLIC_URL=http://localhost:3000/marketplace
MARKETPLACE_MAX_IMAGES=10
MARKETPLACE_MAX_DOCUMENTS=5
MARKETPLACE_RESERVATION_MINUTES=30
PAYMENT_PROVIDER=none
QUOTE_ENABLED=true

# ============================================================
# PHASE 9: CARBON IMPACT, CIRCULARITY METRICS & ESG INTELLIGENCE
# ============================================================
CARBON_PROVIDER=mock
CARBON_METHODOLOGY_VERSION=1.0
CARBON_FACTOR_VERSION=1.0
CARBON_CALCULATION_VERSION=carbon-v1
CARBON_DEFAULT_CURRENCY=INR
IMPACT_SCENARIOS_ENABLED=true
IMPACT_REPORTING_ENABLED=true

# ============================================================
# PHASE 10: ENTERPRISE REPORTING, EXECUTIVE ANALYTICS & PLATFORM
# ============================================================
REPORTS_PDF_GENERATION_ENABLED=true
REPORTS_DEFAULT_ORIENTATION=portrait
REPORTS_WATERMARK_DEMO=true
REPORT_SHARE_TOKEN_EXPIRY_DAYS=7
NOTIFICATIONS_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365
INTEGRITY_CHECK_ON_INGESTION=true


# ============================================================
# ECOINTEL PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================

# Database Connection (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ecointel?retryWrites=true&w=majority

# Authentication Secrets (JWT Access & Refresh Tokens)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_characters_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_here

# Asset & Cloud Storage (Cloudinary / S3 Object Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Distributed Cache & Job Queue (Redis + BullMQ)
REDIS_URL=redis://default:<password>@<host>:<port>

# Application Base URL
APP_URL=http://localhost:3000

# AI Component Detection Provider (mock | yolo)
DETECTION_PROVIDER=mock

# External AI Inference Microservice (YOLO / Python FastAPI)
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_API_KEY=eco-intel-internal-ai-key-2026
YOLO_MODEL_PATH=
YOLO_CONFIDENCE=0.35
YOLO_IOU=0.45

# Digital Product Passport Blockchain (Polygon Testnet / Mainnet)
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_PRIVATE_KEY=your_polygon_private_key_do_not_commit
POLYGON_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Decentralized Storage for Passport Metadata (IPFS)
IPFS_API_URL=https://ipfs.infura.io:5001/api/v0

# ============================================================
# PHASE 4: HEALTH ASSESSMENT & REMAINING USEFUL LIFE (RUL)
# ============================================================
RUL_PROVIDER=mock
RUL_MODEL_PATH=ai-service/rul/models/rul_xgb_model.json
RUL_MODEL_VERSION=1.0.0
RUL_DATASET_VERSION=rul-synthetic-v1
RUL_FEATURE_VERSION=rul-features-v1
RUL_CONFIDENCE_THRESHOLD=0.70
RUL_MAX_INPUT_SIZE=500
AI_SERVICE_INTERNAL_KEY=eco-intel-internal-ai-key-2026


# ==========================================
# AI Circular Electronics Platform (AICEP)
# Environment Configuration Template
# ==========================================

# Database Configuration (MongoDB)
# Local: mongodb://localhost:27017/eco_intel
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/eco_intel?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/eco_intel

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="AI Circular Electronics Platform (AICEP)"

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# AI / ML Inference Service (Optional Python FastAPI backend for YOLO/RUL models)
AI_SERVICE_URL=http://localhost:8000

# Blockchain / Digital Passport Configuration (Polygon)
BLOCKCHAIN_NETWORK=polygon-amoy
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology/
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Cloud Storage / Media Uploads (Optional: Cloudinary or AWS S3 for PCB inspection images)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
